{
  "id": "LendLoopRemind01",
  "name": "LendLoop - Overdue reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "6ebd4123-ca04-5e95-8b7e-d93575d38489",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "1f528d09-4d12-5767-9aca-918b92ee771e",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "46b56caf-2345-5396-95a6-97a57635ee4c",
              "name": "timestamp",
              "value": "={{ Date.now().toString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b16296e7-d352-5103-a47d-870fded37ccc",
      "name": "Timestamp request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "encoding": "hex",
        "dataPropertyName": "signature",
        "value": "={{ $json.timestamp }}.GET./n8n/overdue-loans."
      },
      "id": "d58556f7-587b-5b93-a31f-fc183da7615b",
      "name": "Sign request",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "crypto": {
          "id": "LendLoopHmacOut1",
          "name": "LendLoop API signing secret (n8n to Convex)"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "=sha256={{ $json.signature }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "4b0f7082-d35c-543c-98f7-428fb27026f4",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      },
      "id": "fa4ac553-e1ee-54a1-b7c4-843bdcd3027b",
      "name": "Split out loans",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.LENDLOOP_FROM_EMAIL }}",
        "toEmail": "={{ $json.borrower.email }}",
        "subject": "=Reminder: {{ $json.toolName }} was due back on {{ $json.dueDate }}",
        "emailFormat": "text",
        "text": "=Hi {{ $json.borrower.name }},\n\n{{ $json.toolName }} was due back on {{ $json.dueDate }} and is now {{ $json.daysOverdue }} day{{ $json.daysOverdue === 1 ? '' : 's' }} overdue.\n\nPlease return it to your neighbor as soon as you can.\n\n\u2014 LendLoop",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "c8d6eba1-49db-5456-8d2e-75d05be3dba7",
      "name": "Send reminder email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "LendLoopSmtp0001",
          "name": "LendLoop SMTP"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "46b56caf-2345-5396-95a6-97a57635ee4c",
              "name": "timestamp",
              "value": "={{ Date.now().toString() }}",
              "type": "string"
            },
            {
              "id": "d5e5ce57-cc53-5aa6-8d9d-f1aaeb17c72a",
              "name": "body",
              "value": "={{ JSON.stringify({ loanId: $('Split out loans').item.json.loanId, reminderDate: $('Split out loans').item.json.reminderDate, status: 'sent', channel: 'email', executionId: $execution.id }) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "63e2bd50-6982-5702-9311-6cca8b210905",
      "name": "Reminder sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "46b56caf-2345-5396-95a6-97a57635ee4c",
              "name": "timestamp",
              "value": "={{ Date.now().toString() }}",
              "type": "string"
            },
            {
              "id": "d5e5ce57-cc53-5aa6-8d9d-f1aaeb17c72a",
              "name": "body",
              "value": "={{ JSON.stringify({ loanId: $('Split out loans').item.json.loanId, reminderDate: $('Split out loans').item.json.reminderDate, status: 'failed', channel: 'email', error: String($json.error?.message ?? $json.error ?? 'Email could not be sent'), executionId: $execution.id }) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "de54fd2b-8a7a-5c45-ae1e-aea1c6ddb6b4",
      "name": "Reminder failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        120
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "encoding": "hex",
        "dataPropertyName": "signature",
        "value": "={{ $json.timestamp }}.POST./n8n/reminders.{{ $json.body }}"
      },
      "id": "fce04064-6479-545c-9371-3fcafe1d6586",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "crypto": {
          "id": "LendLoopHmacOut1",
          "name": "LendLoop API signing secret (n8n to Convex)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "=sha256={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "2820cedc-04f7-5139-83af-5d3e893bfe14",
      "name": "Record reminder in LendLoop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "51f1a865-bc48-5ecc-9b7f-575540445ecf",
              "leftValue": "={{ $json.status === 'failed' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fdfd092c-7a25-5ead-9218-1aec47217e1d",
      "name": "Reminder failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        0
      ]
    },
    {
      "parameters": {
        "errorMessage": "An overdue reminder email could not be sent. The failure is recorded on the loan in LendLoop and will be retried on the next run."
      },
      "id": "c1fb0b8e-01c9-5019-a611-6e527e812b9e",
      "name": "Fail the run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        2200,
        -20
      ]
    }
  ],
  "connections": {
    "Every day at 09:00": {
      "main": [
        [
          {
            "node": "Timestamp request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run manually": {
      "main": [
        [
          {
            "node": "Timestamp request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Timestamp request": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "Split out loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split out loans": {
      "main": [
        [
          {
            "node": "Send reminder email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder email": {
      "main": [
        [
          {
            "node": "Reminder sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reminder failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reminder sent": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reminder failed": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Record reminder in LendLoop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record reminder in LendLoop": {
      "main": [
        [
          {
            "node": "Reminder failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reminder failed?": {
      "main": [
        [
          {
            "node": "Fail the run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrors01",
    "saveDataErrorExecution": "all"
  },
  "active": false,
  "pinData": {}
}
