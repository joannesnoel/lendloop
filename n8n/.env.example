# Copy to n8n/.env (git-ignored) and fill in. Used by docker compose and by
# `npm run n8n:setup`.

# --- Secrets -----------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
# They must match the values set on the Convex deployment (npx convex env set).
# The setup script stores them as encrypted n8n credentials; they are never
# given to the n8n container as environment variables.

# Signs webhooks Convex sends to n8n.
LENDLOOP_WEBHOOK_SECRET=
# Signs requests n8n sends to Convex.
LENDLOOP_API_SECRET=

# --- Settings (not secret) ---------------------------------------------------
# Your Convex HTTP Actions URL, as seen from inside the n8n container.
#   Convex cloud:        https://<deployment>.convex.site
#   Convex local (dev):  http://host.docker.internal:3211
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

LENDLOOP_FROM_EMAIL=LendLoop <no-reply@lendloop.local>
# Where the error workflow sends failure alerts.
LENDLOOP_ALERT_EMAIL=ops@lendloop.local

# SMTP server for outgoing mail. Defaults to the bundled Mailpit catcher.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Host ports.
N8N_PORT=5678
MAILPIT_UI_PORT=8025
# Public base URL of n8n, if it is exposed through a tunnel or reverse proxy.
# N8N_PUBLIC_URL=https://n8n.example.com
TZ=UTC
