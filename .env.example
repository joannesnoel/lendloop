# Copy to .env.local (git-ignored) and fill in.

# Clerk: https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex: written for you by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# These are NOT read from this file. They live on the Convex deployment and
# are set with `npx convex env set NAME value`:
#
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL (https://<app>.clerk.accounts.dev)
#   ADMIN_EMAILS              Comma-separated emails that become admins on sign-in
#   N8N_WEBHOOK_URL           <n8n base URL>/webhook/lendloop/loan-events
#   LENDLOOP_WEBHOOK_SECRET   Signs webhooks Convex sends to n8n
#   LENDLOOP_API_SECRET       Verifies requests n8n sends to Convex
# ---------------------------------------------------------------------------
